// ==============================================================================
// PRISMA DATABASE SCHEMA — JUNGLAN COMMUNITY DEVELOPMENT FOUNDATION
// ==============================================================================
// PART 4: PRODUCTION-GRADE DATABASE & BACKEND ARCHITECTURE
// Authoritative Source of Truth: PostgreSQL
//
// Key Architectural Principles:
// 1. PostgreSQL is the single primary source of truth (Google Sheets is an integration layer).
// 2. All monetary amounts strictly use Decimal @db.Decimal(12, 2) (NO floating-point).
// 3. Operational records belong to a specific YearPeriod (historical preservation, no destructive deletes).
// 4. Patient information is strictly PRIVATE and protected with stable unique identifiers.
// 5. Two private roles only: ADMIN and DATA_ENTRY.
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. ACCESS CONTROL & ROLES (Sections 9, 10, 11)
// ------------------------------------------------------------------------------
enum UserRole {
  ADMIN
  DATA_ENTRY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(DATA_ENTRY)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  loggedExpenses     Expense[]        @relation("ExpenseLogger")
  loggedFunding      Funding[]        @relation("FundingLogger")
  loggedFuel         FuelLog[]        @relation("FuelLogger")
  loggedMaintenance  MaintenanceLog[] @relation("MaintenanceLogger")
  dispatchedTrips    Trip[]           @relation("TripDispatcher")
  createdPatients    Patient[]        @relation("PatientCreator")
  generatedReports   Report[]         @relation("ReportGenerator")
  auditLogs          AuditLog[]       @relation("AuditUser")

  @@map("users")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "patients.read", "trips.create"
  description String
  module      String   // "PATIENTS", "TRIPS", "EXPENSES", "REPORTS", etc.
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  createdAt    DateTime   @default(now())

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// 2. FISCAL YEAR & HISTORICAL RECORDS MANAGEMENT (Sections 26, 27, 28)
// ------------------------------------------------------------------------------
enum YearPeriodStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

model YearPeriod {
  id              String           @id // e.g. "2026"
  year            Int              @unique // 2026
  label           String           // e.g. "Operational Year 2026"
  status          YearPeriodStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  isCurrentActive Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relational Records under this Year
  patients        Patient[]
  trips           Trip[]
  expenses        Expense[]
  funding         Funding[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  reports         Report[]

  @@map("year_periods")
}

// ------------------------------------------------------------------------------
// 3. COMMUNITY PROJECTS & CMS (Sections 12, 13, 14, 15)
// ------------------------------------------------------------------------------
enum ProjectCategory {
  HEALTHCARE
  AGRICULTURE
  COMMUNITY_DEVELOPMENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id                         String          @id @default(cuid())
  slug                       String          @unique
  title                      String
  category                   ProjectCategory
  shortDescription           String
  fullDescription            String          @db.Text
  coverImageUrl              String
  targetFundingPKR           Decimal?        @db.Decimal(12, 2)
  currentFundingPKR          Decimal?        @default(0) @db.Decimal(12, 2)
  beneficiariesImpactedCount Int             @default(0)
  status                     ProjectStatus   @default(ACTIVE)
  isFeatured                 Boolean         @default(false)
  isPublic                   Boolean         @default(true)
  orderIndex                 Int             @default(0)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  updates                    ProjectUpdate[]
  funding                    Funding[]

  @@index([category])
  @@index([status])
  @@map("projects")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model News {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  category         String
  excerpt          String
  content          String        @db.Text
  featuredImageUrl String?
  status           ContentStatus @default(PUBLISHED)
  publishedAt      DateTime?     @default(now())
  authorName       String
  createdById      String?
  isPublished      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@map("news")
}

model ProjectUpdate {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  content     String        @db.Text
  status      ContentStatus @default(PUBLISHED)
  updateDate  DateTime      @default(now())
  author      String
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_updates")
}

model OperationalLocation {
  id                      String   @id @default(cuid())
  name                    String
  region                  String   // e.g. "Hazara"
  district                String   // e.g. "Mansehra"
  areaCommunity           String   // e.g. "Junglan Valley"
  latitude                Float?
  longitude               Float?
  ambulanceStationedCount Int      @default(0)
  isPublic                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("operational_locations")
}

// ------------------------------------------------------------------------------
// 4. PATIENT RECORDS (Strictly Private — Sections 16, 17, 36, 38, 40)
// ------------------------------------------------------------------------------
enum DataSource {
  WEBSITE
  GOOGLE_SHEETS
  IMPORT
  SYSTEM
}

enum SyncStatus {
  SYNCED
  PENDING
  PROCESSING
  CONFLICT
  FAILED
  REVIEW_REQUIRED
}

model Patient {
  id                      String     @id @default(cuid())
  patientIdentifier       String     @unique // e.g. "JCD-P-2026-0001" (Stable Unique ID)
  fullName                String
  cnicOrBForm             String?
  gender                  String     // "MALE", "FEMALE", "OTHER"
  age                     Int
  contactNumber           String
  emergencyContactName    String?
  emergencyContactPhone   String?
  residenceArea           String
  medicalConditionSummary String     @db.Text
  notes                   String?    @db.Text
  yearPeriodId            String
  createdById             String?

  // Lifecycle & Integrity
  isFlaggedForReview      Boolean    @default(false)
  flagReason              String?
  isArchived              Boolean    @default(false)
  deletedAt               DateTime?

  // Sync Metadata (Section 38 & 40)
  externalId              String?
  source                  DataSource @default(WEBSITE)
  syncStatus              SyncStatus @default(SYNCED)
  lastSyncedAt            DateTime?
  syncVersion             Int        @default(1)

  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  // Relationships
  yearPeriod              YearPeriod @relation(fields: [yearPeriodId], references: [id])
  createdBy               User?      @relation("PatientCreator", fields: [createdById], references: [id])
  trips                   Trip[]

  @@index([patientIdentifier])
  @@index([yearPeriodId])
  @@index([contactNumber])
  @@index([cnicOrBForm])
  @@index([deletedAt])
  @@map("patients")
}

// ------------------------------------------------------------------------------
// 5. AMBULANCE FLEET & DISPATCH TRACKING (Sections 18, 19)
// ------------------------------------------------------------------------------
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
}

model AmbulanceVehicle {
  id                  String           @id @default(cuid())
  ambulanceIdentifier String           @unique // e.g. "AMB-01"
  registrationNumber  String           @unique // e.g. "ICT-LE-482"
  model               String
  manufacturingYear   Int
  status              VehicleStatus    @default(AVAILABLE)
  currentOdometerKm   Decimal          @default(0) @db.Decimal(10, 1)
  assignedDriverName  String?
  isActive            Boolean          @default(true)

  // Sync Metadata
  externalId          String?
  source              DataSource       @default(WEBSITE)
  syncStatus          SyncStatus       @default(SYNCED)
  lastSyncedAt        DateTime?
  syncVersion         Int              @default(1)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  trips               Trip[]
  fuelLogs            FuelLog[]
  maintenanceLogs     MaintenanceLog[]

  @@map("ambulance_vehicles")
}

enum TripStatus {
  SCHEDULED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  ROUTINE
  URGENT
  CRITICAL
}

enum TripType {
  EMERGENCY_TRANSFER
  INTER_HOSPITAL
  MATERNAL_TRANSIT
  DISASTER_RELIEF
  ROUTINE_TRANSPORT
}

model Trip {
  id              String           @id @default(cuid())
  tripIdentifier  String           @unique // e.g. "TRP-2026-000001"
  date            DateTime
  ambulanceId     String
  patientId       String?
  patientName     String           // Operational snapshot
  patientPhone    String?
  pickupLocation  String
  dropoffHospital String
  tripType        TripType         @default(EMERGENCY_TRANSFER)
  distanceKm      Decimal          @default(0) @db.Decimal(8, 2)
  startOdometerKm Decimal          @db.Decimal(10, 1)
  endOdometerKm   Decimal?         @db.Decimal(10, 1)
  dispatchTime    DateTime
  completedTime   DateTime?
  status          TripStatus       @default(DISPATCHED)
  urgencyLevel    UrgencyLevel     @default(URGENT)
  driverName      String
  paramedicName   String?
  notes           String?          @db.Text
  yearPeriodId    String
  createdById     String?

  // Lifecycle & Integrity
  isArchived      Boolean          @default(false)
  deletedAt       DateTime?

  // Sync Metadata
  externalId      String?
  source          DataSource       @default(WEBSITE)
  syncStatus      SyncStatus       @default(SYNCED)
  lastSyncedAt    DateTime?
  syncVersion     Int              @default(1)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  ambulance       AmbulanceVehicle @relation(fields: [ambulanceId], references: [id])
  patient         Patient?         @relation(fields: [patientId], references: [id])
  yearPeriod      YearPeriod       @relation(fields: [yearPeriodId], references: [id])
  createdBy       User?            @relation("TripDispatcher", fields: [createdById], references: [id])

  @@index([yearPeriodId])
  @@index([ambulanceId])
  @@index([status])
  @@index([date])
  @@index([deletedAt])
  @@map("trips")
}

// ------------------------------------------------------------------------------
// 6. FINANCIAL ACCOUNTING: EXPENSES & FUNDING (Sections 20, 21, 48)
// ------------------------------------------------------------------------------
enum ExpenseCategory {
  FUEL
  MAINTENANCE
  REPAIR
  OPERATIONS
  SUPPLIES
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Expense {
  id                 String          @id @default(cuid())
  voucherNumber      String          @unique // e.g. "EXP-2026-000001"
  date               DateTime
  amountPKR          Decimal         @db.Decimal(12, 2) // Strict Decimal
  category           ExpenseCategory
  title              String
  description        String          @db.Text
  paidTo             String
  receiptDocumentRef String?
  projectId          String?
  status             ExpenseStatus   @default(PENDING_APPROVAL)
  approvedByUserId   String?
  loggedByUserId     String
  yearPeriodId       String

  // Lifecycle
  isArchived         Boolean         @default(false)
  deletedAt          DateTime?

  // Sync Metadata
  externalId         String?
  source             DataSource      @default(WEBSITE)
  syncStatus         SyncStatus      @default(SYNCED)
  lastSyncedAt       DateTime?
  syncVersion        Int             @default(1)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  loggedByUser       User            @relation("ExpenseLogger", fields: [loggedByUserId], references: [id])
  yearPeriod         YearPeriod      @relation(fields: [yearPeriodId], references: [id])

  @@index([yearPeriodId])
  @@index([category])
  @@index([date])
  @@index([deletedAt])
  @@map("expenses")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  ONLINE_PORTAL
  CHEQUE
  OTHER
}

model Funding {
  id                 String        @id @default(cuid())
  referenceNumber    String        @unique // e.g. "FND-2026-000001"
  date               DateTime
  amountPKR          Decimal       @db.Decimal(12, 2) // Strict Decimal
  source             String        // "Individual Donor", "Grant", "Corporate CSR"
  donorName          String?
  donorContact       String?
  projectId          String?
  purpose            String
  paymentMethod      PaymentMethod @default(BANK_TRANSFER)
  receiptDocumentRef String?
  yearPeriodId       String
  loggedByUserId     String?
  isAnonymous        Boolean       @default(false)

  // Lifecycle
  isArchived         Boolean       @default(false)
  deletedAt          DateTime?

  // Sync Metadata
  externalId         String?
  dataSource         DataSource    @default(WEBSITE)
  syncStatus         SyncStatus    @default(SYNCED)
  lastSyncedAt       DateTime?
  syncVersion        Int           @default(1)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project            Project?      @relation(fields: [projectId], references: [id])
  yearPeriod         YearPeriod    @relation(fields: [yearPeriodId], references: [id])
  loggedByUser       User?         @relation("FundingLogger", fields: [loggedByUserId], references: [id])

  @@index([yearPeriodId])
  @@index([projectId])
  @@index([date])
  @@index([deletedAt])
  @@map("funding")
}

// ------------------------------------------------------------------------------
// 7. FLEET LOGS: FUEL & MAINTENANCE (Sections 22, 23, 48)
// ------------------------------------------------------------------------------
enum FuelType {
  DIESEL
  PETROL
  CNG
}

model FuelLog {
  id                String           @id @default(cuid())
  voucherNumber     String           @unique // e.g. "FUEL-2026-000001"
  date              DateTime
  liters            Decimal          @db.Decimal(8, 2)
  pricePerLiterPKR  Decimal          @db.Decimal(8, 2)
  totalCostPKR      Decimal          @db.Decimal(12, 2) // Strict Decimal
  ambulanceId       String
  fuelType          FuelType         @default(DIESEL)
  odometerReadingKm Decimal          @db.Decimal(10, 1)
  fuelStationName   String
  receiptNumber     String?
  notes             String?
  yearPeriodId      String
  loggedByUserId    String?

  isArchived        Boolean          @default(false)
  deletedAt         DateTime?

  // Sync Metadata
  externalId        String?
  source            DataSource       @default(WEBSITE)
  syncStatus        SyncStatus       @default(SYNCED)
  lastSyncedAt      DateTime?
  syncVersion       Int              @default(1)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  ambulance         AmbulanceVehicle @relation(fields: [ambulanceId], references: [id])
  yearPeriod        YearPeriod       @relation(fields: [yearPeriodId], references: [id])
  loggedByUser      User?            @relation("FuelLogger", fields: [loggedByUserId], references: [id])

  @@index([ambulanceId])
  @@index([yearPeriodId])
  @@index([date])
  @@map("fuel_logs")
}

enum MaintenanceType {
  ROUTINE_SERVICE
  OIL_FILTER_CHANGE
  TIRE_REPLACEMENT
  BRAKE_REPAIR
  ENGINE_OVERHAUL
  BODY_WORK
  ELECTRICAL_REPAIR
  OTHER
}

model MaintenanceLog {
  id                 String           @id @default(cuid())
  recordNumber       String           @unique // e.g. "MNT-2026-000001"
  date               DateTime
  serviceType        MaintenanceType  @default(ROUTINE_SERVICE)
  description        String           @db.Text
  costPKR            Decimal          @db.Decimal(12, 2) // Strict Decimal
  ambulanceId        String
  workshopName       String
  odometerReadingKm  Decimal          @db.Decimal(10, 1)
  invoiceNumber      String?
  receiptDocumentRef String?
  notes              String?
  yearPeriodId       String
  loggedByUserId     String?

  isArchived         Boolean          @default(false)
  deletedAt          DateTime?

  // Sync Metadata
  externalId         String?
  source             DataSource       @default(WEBSITE)
  syncStatus         SyncStatus       @default(SYNCED)
  lastSyncedAt       DateTime?
  syncVersion        Int              @default(1)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  ambulance          AmbulanceVehicle @relation(fields: [ambulanceId], references: [id])
  yearPeriod         YearPeriod       @relation(fields: [yearPeriodId], references: [id])
  loggedByUser       User?            @relation("MaintenanceLogger", fields: [loggedByUserId], references: [id])

  @@index([ambulanceId])
  @@index([yearPeriodId])
  @@index([date])
  @@map("maintenance_logs")
}

// ------------------------------------------------------------------------------
// 8. REPORTS & DOCUMENT MANAGEMENT (Sections 24, 25, 33)
// ------------------------------------------------------------------------------
enum ReportType {
  MONTHLY_OPERATIONAL
  ANNUAL_AUDIT
  PROJECT_SUMMARY
  FLEET_UTILIZATION
  FINANCIAL_DISCLOSURE
  PUBLIC_TRANSPARENCY
}

enum ReportStatus {
  DRAFT
  FINALIZED
  PUBLISHED
  ARCHIVED
}

enum ReportVisibility {
  PUBLIC
  INTERNAL_ADMIN
}

model Report {
  id                String             @id @default(cuid())
  reportType        ReportType
  yearPeriodId      String
  month             Int?               // 1-12
  title             String
  description       String?            @db.Text
  status            ReportStatus       @default(DRAFT)
  visibility        ReportVisibility   @default(PUBLIC)
  documentRef       String?
  generatedByUserId String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  yearPeriod        YearPeriod         @relation(fields: [yearPeriodId], references: [id])
  generatedByUser   User?              @relation("ReportGenerator", fields: [generatedByUserId], references: [id])
  generations       ReportGeneration[]

  @@index([yearPeriodId])
  @@index([reportType])
  @@index([status])
  @@map("reports")
}

enum ReportFormat {
  PDF
  DOCX
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReportGeneration {
  id                String           @id @default(cuid())
  reportId          String
  requestedByUserId String
  status            GenerationStatus @default(PENDING)
  format            ReportFormat     @default(PDF)
  startedAt         DateTime?
  completedAt       DateTime?
  fileReference     String?
  errorInformation  String?
  createdAt         DateTime         @default(now())

  report            Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_generations")
}

enum StorageProvider {
  LOCAL_FS
  GOOGLE_DRIVE
  AWS_S3
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

model Document {
  id                 String             @id @default(cuid())
  fileName           String
  fileType           String
  storageProvider    StorageProvider    @default(LOCAL_FS)
  storageReference   String
  visibility         DocumentVisibility @default(PRIVATE)
  relatedEntityType  String?            // "EXPENSE", "FUNDING", "MAINTENANCE", "REPORT"
  relatedEntityId    String?
  uploadedByUserId   String?
  createdAt          DateTime           @default(now())

  @@index([relatedEntityType, relatedEntityId])
  @@map("documents")
}

// ------------------------------------------------------------------------------
// 9. AUDIT LOGGING & SYSTEM TRACEABILITY (Sections 30, 31)
// ------------------------------------------------------------------------------
enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  LOGIN
  LOGOUT
  EXPORT
  GENERATE_REPORT
  SYNC
  SYNC_CONFLICT
  SYNC_RESOLVED
  GOOGLE_CONNECT
  GOOGLE_DISCONNECT
}

model AuditLog {
  id                String          @id @default(cuid())
  userId            String?
  action            AuditActionType
  module            String          // "PATIENTS", "TRIPS", "EXPENSES", "FUNDING", "FLEET", "CMS", "SYSTEM", "GOOGLE_SYNC"
  recordId          String
  timestamp         DateTime        @default(now())
  metadataJson      String?         @db.Text

  user              User?           @relation("AuditUser", fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([timestamp])
  @@index([action])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 10. GOOGLE INTEGRATION & TWO-WAY SYNCHRONIZATION ARCHITECTURE (Part 7)
// ------------------------------------------------------------------------------
enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
  CONFIGURING
  NEEDS_REAUTH
}

enum SyncDirection {
  OUTBOUND // Website / DB -> Google Sheets / Drive
  INBOUND  // Google Sheets / Drive -> Website / DB
  BIDIRECTIONAL
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
  CANCELLED
}

enum SyncLogStatus {
  SYNCED
  SKIPPED
  CONFLICT
  FAILED
  DUPLICATE_DETECTED
  REVIEW_REQUIRED
}

enum ConflictStatus {
  OPEN
  RESOLVED_KEEP_DB
  RESOLVED_KEEP_SHEET
  RESOLVED_MERGED
  DISMISSED
}

enum SyncRecordType {
  PATIENT
  TRIP
  EXPENSE
  FUNDING
  FUEL
  MAINTENANCE
  AMBULANCE
  DOCUMENT
}

model GoogleIntegration {
  id                    String            @id @default(cuid())
  provider              String            @default("GOOGLE_SHEETS") // GOOGLE_SHEETS, GOOGLE_DRIVE
  integrationType       String            @default("TWO_WAY_SYNC")  // "TWO_WAY_SYNC", "DOCUMENT_BACKUP"
  status                IntegrationStatus @default(CONFIGURING)
  accountEmail          String?
  authType              String            @default("SERVICE_ACCOUNT") // "SERVICE_ACCOUNT" | "OAUTH2"
  encryptedAccessToken  String?           @db.Text
  encryptedRefreshToken String?           @db.Text
  tokenExpiresAt        DateTime?
  driveRootFolderId     String?
  driveRootFolderName   String            @default("Junglan Community Development Foundation")
  spreadsheetId         String?
  syncHealth            String            @default("HEALTHY") // "HEALTHY" | "DEGRADED" | "ERROR"
  failedSyncCount       Int               @default(0)
  conflictCount         Int               @default(0)
  lastSyncAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  syncStatus            String?
  errorMetadata         String?           @db.Text
  settingsJson          String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("google_integrations")
}

model SyncJob {
  id                 String         @id @default(cuid())
  jobIdentifier      String         @unique // e.g. "SYNC-2026-000001"
  direction          SyncDirection  @default(BIDIRECTIONAL)
  scope              String         @default("ALL") // "ALL", "PATIENTS", "TRIPS", "EXPENSES", etc.
  status             SyncJobStatus  @default(PENDING)
  yearPeriodId       String?
  isLocked           Boolean        @default(false)
  recordsProcessed   Int            @default(0)
  recordsCreated     Int            @default(0)
  recordsUpdated     Int            @default(0)
  duplicatesDetected Int            @default(0)
  conflictsDetected  Int            @default(0)
  failuresCount      Int            @default(0)
  skippedCount       Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  triggeredByUserId  String?
  errorDetails       String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  logs               SyncLog[]
  conflicts          SyncConflict[]

  @@index([status])
  @@index([direction])
  @@index([createdAt])
  @@map("sync_jobs")
}

model SyncLog {
  id                String         @id @default(cuid())
  syncJobId         String?
  recordType        SyncRecordType
  recordId          String
  stableIdentifier  String?        // e.g. "PAT-000011", "TRP-2026-000001", "EXP-2026-000015"
  externalReference String?        // Google Sheet row index, tab, or Drive file ID
  direction         SyncDirection
  status            SyncLogStatus
  errorCode         String?
  errorMessage      String?        @db.Text
  retryCount        Int            @default(0)
  maxRetries        Int            @default(3)
  nextRetryAt       DateTime?
  payloadSnapshot   String?        @db.Text // Sanitized JSON (NO credentials/passwords)
  createdAt         DateTime       @default(now())

  syncJob           SyncJob?       @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([syncJobId])
  @@index([recordType, recordId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

model SyncConflict {
  id                 String         @id @default(cuid())
  conflictIdentifier String         @unique // e.g. "CNF-2026-000001"
  syncJobId          String?
  recordType         SyncRecordType
  recordId           String
  stableIdentifier   String         // e.g. "EXP-2026-000015"
  sheetRowReference  String?
  databaseValueJson  String         @db.Text
  sheetValueJson     String         @db.Text
  lastDatabaseUpdate DateTime
  lastSheetUpdate    DateTime?
  conflictReason     String         @db.Text
  status             ConflictStatus @default(OPEN)
  resolvedByUserId   String?
  resolvedAt         DateTime?
  resolutionNotes    String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  syncJob            SyncJob?       @relation(fields: [syncJobId], references: [id], onDelete: SetNull)

  @@index([syncJobId])
  @@index([recordType, recordId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_conflicts")
}

model ExternalRecordMapping {
  id               String         @id @default(cuid())
  recordType       SyncRecordType
  internalRecordId String
  stableIdentifier String         // e.g. "PAT-000011"
  yearPeriodId     String         // e.g. "2026"
  spreadsheetId    String
  sheetTabName     String         // e.g. "Ambulance Service Patient Reco"
  sheetTabGid      String         // e.g. "0"
  lastRowIndex     Int?           // Cached row position (never used as primary identity)
  lastSyncedHash   String?        // SHA-256 hash of synced fields
  version          Int            @default(1)
  lastSyncedAt     DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([recordType, internalRecordId])
  @@unique([spreadsheetId, sheetTabName, stableIdentifier])
  @@index([yearPeriodId])
  @@index([stableIdentifier])
  @@map("external_record_mappings")
}

