# ==============================================================================
# JUNGLAN COMMUNITY DEVELOPMENT FOUNDATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local, .env, or real secrets into version control.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Prisma ORM)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/junglan_foundation_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js / JWT Session)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-32-character-secret"

# ------------------------------------------------------------------------------
# 3. GOOGLE INTEGRATIONS (OAuth, Drive, Sheets)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 4. INTERNAL AI CONFIGURATION (Server-Side Only - Private Assistant)
# ------------------------------------------------------------------------------
AI_API_KEY=""
AI_MODEL="gemini-1.5-pro"
AI_MAX_OUTPUT_TOKENS="2048"

# ------------------------------------------------------------------------------
# 5. PUBLIC CONTACT & METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FOUNDATION_PHONE="+1 (800) 586-4526"
NEXT_PUBLIC_FOUNDATION_EMAIL="contact@junglanfoundation.org"
