# ==============================================================================
# JUNGLAN COMMUNITY DEVELOPMENT FOUNDATION — ENVIRONMENT CONFIGURATION
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO GIT.
# Copy this file to .env.local and fill in the required values for your environment.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL — Primary Source of Truth)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/junglan_foundation?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (NextAuth / JWT Session Management)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random string with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME & METADATA
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Junglan Community Development Foundation"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="info@junglanfoundation.org"
NEXT_PUBLIC_AMBULANCE_HOTLINE="+92 300 0000000"

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD INTEGRATION (Sheets & Drive Two-Way Sync — Part 7)
# ------------------------------------------------------------------------------
# Authentication Mode: "SERVICE_ACCOUNT" (recommended for 24/7 sync) or "OAUTH2"
GOOGLE_AUTH_MODE="SERVICE_ACCOUNT"

# Option A: Google Service Account (Recommended)
# Create a Service Account in Google Cloud Console, grant Sheets & Drive API roles,
# and paste client email and private key (with escaped \n).
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: OAuth 2.0 Web Application (For user-consent interactive flow)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/google/callback"

# Target Operational Resources
GOOGLE_SPREADSHEET_ID="15uC_XxXwQ9LUgKfHX9r6-p0ZC87ODhn26iX2Yfr2-GU"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

